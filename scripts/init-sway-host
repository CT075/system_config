#!/bin/bash
# Generate dotfiles/hosts/$SYSNAME/sway.conf by picking, for each hook that
# names a program, from the ones actually installed.
#
# The three hooks that describe the machine rather than its software get
# working defaults instead of a prompt: $wallpaper and $autostart_xdg are
# fine as they land, and $out_* is left as a placeholder the script names on
# the way out. A placeholder rather than an empty value because sway takes
# `focus output nosuchthing` as a warning and an empty one as a parse error.

set -eu

here=$(cd "$(dirname "$0")/.." && pwd)
sysname=$("$here/scripts/sysname")
host_dir="$here/dotfiles/hosts/$sysname"

# Candidates in preference order. These are whole commands and not binary
# names, since the flags vary more than the names do; the first word is enough
# to test for.

terminals=(
  kitty
  alacritty
  foot
  wezterm
  ghostty
)

# The dropdown has to carry $title as its app id or 50-scratchpad.conf won't
# recognise the window, and foot spells that flag --app-id.
dropdowns=(
  'kitty --class=$title'
  'alacritty --class=$title'
  'foot --app-id=$title'
  'wezterm start --class $title'
  'ghostty --class=$title'
)

# The chromium family still picks X11 under XWayland on some builds unless
# told otherwise, which costs it fractional scaling and clipboard behaviour.
browsers=(
  vivaldi
  firefox
  'brave-browser --ozone-platform=wayland'
  'chromium --ozone-platform=wayland'
  'google-chrome --ozone-platform=wayland'
)

launchers=(
  'wofi --show=drun,run'
  fuzzel
  'rofi -show drun'
  bemenu-run
)

filemanagers=(
  nautilus
  thunar
  dolphin
  nemo
  pcmanfm
)

backlights=(
  light
  brightnessctl
)

# Which of the trailing candidates to use for [hook], defaulting to the first
# one installed. The menu goes to stderr so the answer can be captured.
choose() {
  local hook=$1 desc=$2
  shift 2

  local -a found=()
  local c
  for c in "$@"; do
    command -v "${c%% *}" >/dev/null 2>&1 && found+=("$c")
  done

  printf '\n%s - %s\n' "$hook" "$desc" >&2
  local i
  for i in "${!found[@]}"; do
    printf '  %d) %s\n' "$((i + 1))" "${found[i]}" >&2
  done
  printf '  c) something else\n' >&2

  local default=c
  [ "${#found[@]}" -gt 0 ] && default=1

  local reply
  while true; do
    printf 'choice [%s]: ' "$default" >&2
    # A failed read is EOF, and the loop would spin on it forever otherwise.
    # Exiting a command substitution fails the assignment, so set -e stops the
    # script rather than just this function.
    read -r reply || { echo >&2; exit 1; }
    reply=${reply:-$default}

    case $reply in
      c)
        printf 'command: ' >&2
        read -r reply || { echo >&2; exit 1; }
        [ -n "$reply" ] && { echo "$reply"; return; }
        ;;
      *[!0-9]*|'') ;;
      *)
        [ "$reply" -ge 1 ] && [ "$reply" -le "${#found[@]}" ] \
          && { echo "${found[reply - 1]}"; return; }
        ;;
    esac

    echo "not one of the options" >&2
  done
}

if [ -e "$host_dir/sway.conf" ]; then
  printf '%s already exists. overwrite? [y/N]: ' "$host_dir/sway.conf" >&2
  read -r reply || reply=n
  case $reply in
    [yY]*) ;;
    *) echo "leaving it alone" >&2; exit 1 ;;
  esac
fi

echo "setting up host '$sysname'" >&2

termbin=$(choose '$termbin' 'terminal, for $mod+Shift+Return' "${terminals[@]}")
term=$(choose '$term' 'dropdown terminal, for $mod+t' "${dropdowns[@]}")
browser=$(choose '$browser' 'browser, for $mod+Shift+p then $mod+c' "${browsers[@]}")
launcher=$(choose '$launcher' 'program launcher, for $mod+p' "${launchers[@]}")
filemanager=$(choose '$filemanager' 'file manager, for $mod+Shift+p then $mod+f' "${filemanagers[@]}")
backlight=$(choose '$brightness_up/$brightness_down' 'backlight control' "${backlights[@]}")

# The two halves of the backlight pair don't share a shape, so the choice
# picks a program and the program decides both lines.
#
# light takes an absolute percentage, so a fixed step is uneven at the dim
# end: the 1.4x ramp is roughly perceptual, and the +.72 keeps integer
# truncation from pinning the value at 0. brightnessctl takes a relative one
# and needs none of that.
case ${backlight%% *} in
  light)
    brightness_up='light -S "$(light -G | awk '\''{ print int(($1 + .72) * 1.4) }'\'')"'
    brightness_down='light -S "$(light -G | awk '\''{ print int($1 / 1.4) }'\'')"'
    ;;
  brightnessctl)
    brightness_up='brightnessctl set +10%'
    brightness_down='brightnessctl set 10%-'
    ;;
  *)
    brightness_up="$backlight"
    brightness_down="$backlight"
    echo "$backlight isn't one this script knows a step for; both directions"\
      "got the bare command, so edit them" >&2
    ;;
esac

mkdir -p "$host_dir"

cat > "$host_dir/sway.conf" <<CONF
# Per-host sway hooks for $sysname. Generated by scripts/init-sway-host.

# Preferred applications.
set \$termbin $termbin
set \$term $term
set \$browser $browser
set \$launcher $launcher
set \$filemanager $filemanager
set \$brightness_up $brightness_up
set \$brightness_down $brightness_down

# XDG autostart. \`dex --autostart --environment i3\` where dex is installed.
set \$autostart_xdg true

# Wallpaper, the whole tail of \`output * bg\` in 20-output.conf, so either
# \`/path/to/image.png stretch\` or a solid colour. A path that doesn't resolve
# is a config error rather than a warning and puts swaynag on screen at every
# reload, so the default is the colour.
set \$wallpaper #242424 solid_color

# Monitors, for the \$mod+w/e/r bindings in 64-bindings-output.conf. Laid out
# left to right, and kept in sync by hand with the positions in
# hosts/$sysname/kanshi, which is what actually places the outputs.
#
# \`swaymsg -t get_outputs\` lists what's connected. An output can be named by
# connector (eDP-1) or by make/model/serial, which is what to reach for when a
# connector drifts across reboots. Fewer than three heads means repeating a
# name; a single-head machine sets all three the same.
set \$out_left  TODO
set \$out_main  TODO
set \$out_right TODO
CONF

# link-sway symlinks this one unconditionally, so an absent file would leave
# ~/.config/kanshi/config dangling and kanshi.service failing at every reload.
if [ ! -e "$host_dir/kanshi" ]; then
  cat > "$host_dir/kanshi" <<CONF
# Output geometry for $sysname. 20-output.conf restarts kanshi.service on
# every sway reload, so this file is the only place positions are set.
#
# profile docked {
#   output eDP-1 position 0,0
#   output HDMI-A-1 position 1920,0 mode 1920x1080
# }
CONF
fi

cat >&2 <<MSG

wrote $host_dir/sway.conf
      $host_dir/kanshi

still to fill in by hand:
  \$out_left / \$out_main / \$out_right, and the kanshi profiles.
  \`swaymsg -t get_outputs\` names what's connected.

then: scripts/link-sway
MSG
