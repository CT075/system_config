#!/bin/bash
# Symlink the sway config into ~/.config, picking the per-host file by SYSNAME.
#
# scripts/init can't do this. Its loop only knows how to map dotfiles/X to
# ~/.X, and sway reads ~/.config/sway/ instead. Symlinks rather than an
# `include .../$(hostname)/...` in the loader because the repo's host key is
# SYSNAME from ~/.host, and the two are only incidentally equal here.

set -eu

# readlink -f rather than $0 directly, because this script is reachable through
# a symlink it creates itself: config.d/40-autostart.conf calls it as
# ~/.config/sway/relink, where an unresolved $0 puts the repo root at
# ~/.config and the very next line fails looking for ~/.config/scripts/sysname.
here=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)

sysname=$("$here/scripts/sysname")

host_dir="$here/dotfiles/hosts/$sysname"
if [ ! -f "$host_dir/sway.conf" ]; then
  echo "no sway.conf for host '$sysname'" >&2
  echo "run scripts/init-sway-host to generate one" >&2
  exit 1
fi

mkdir -p ~/.config/sway ~/.config/kanshi ~/.config/swaync ~/.config/i3status

# A real file here is the pre-repo config, so keep it. Reruns hit a symlink and
# skip this.
if [ -f ~/.config/sway/config ] && [ ! -L ~/.config/sway/config ]; then
  backup=~/.config/sway/config.bak-$(date +%Y%m%d)
  echo "backing up existing config to $backup"
  mv ~/.config/sway/config "$backup"
fi

# ln -sfn into a path that is already a real directory would nest the link
# inside it rather than replace it, so refuse instead.
#
# A link that is already correct is left alone rather than rewritten. This
# script no longer runs only by hand: dotfiles/sway/environment runs it at
# session start and 40-autostart.conf runs it on every reload, so a
# steady-state rerun used to mean seventeen chances for swaybar to exec
# ~/.config/sway/statusbar inside the window where `ln -sfn` had unlinked it
# and not yet replaced it. Skipping is also what makes the output worth
# reading, since a quiet run now means nothing moved.
link() {
  if [ -d "$2" ] && [ ! -L "$2" ]; then
    echo "$2 is a real directory; move it aside and rerun" >&2
    exit 1
  fi
  if [ -L "$2" ] && [ "$(readlink "$2")" = "$1" ]; then
    return
  fi
  echo "$2 -> $1"
  ln -sfn "$1" "$2"
}

link "$here/dotfiles/sway/config" ~/.config/sway/config
link "$here/dotfiles/sway/variables.conf" ~/.config/sway/variables.conf
link "$here/dotfiles/sway/config.d" ~/.config/sway/config.d
# The lock script. 40-autostart.conf's swayidle hooks name ~/.config/sway/lock
# four times, so a host without this link gets a session that never locks and
# says nothing about it. It was symlinked by hand here for a year before anyone
# noticed it wasn't in this list.
link "$here/scripts/swaylock" ~/.config/sway/lock
link "$here/scripts/idle" ~/.config/sway/idle
link "$here/scripts/live" ~/.config/sway/live
link "$here/scripts/idle-suspend" ~/.config/sway/idle-suspend
link "$here/scripts/display" ~/.config/sway/display
link "$here/scripts/present" ~/.config/sway/present
link "$here/scripts/notifyd" ~/.config/sway/notifyd
link "$here/scripts/statusbar" ~/.config/sway/statusbar
link "$here/scripts/wallpaper" ~/.config/sway/wallpaper
link "$host_dir/sway.conf" ~/.config/sway/host.conf
link "$host_dir/kanshi" ~/.config/kanshi/config
# i3status only reads a config file, never a flag, so pinning its output format
# for ~/.config/sway/statusbar takes a whole file. This one is Fedora's
# /etc/i3status.conf plus that single line.
link "$here/dotfiles/i3status/config" ~/.config/i3status/config
link "$here/dotfiles/swaync/config.json" ~/.config/swaync/config.json
link "$here/dotfiles/swaync/style.css" ~/.config/swaync/style.css
# The hook that makes this script run at session start. /usr/bin/start-sway
# sources ~/.config/sway/environment just before it execs sway, which is the
# last point anything user-owned runs with the compositor not yet reading
# config. Linking it from here means the first run on a host is still by hand;
# after that the linker keeps its own trigger alive.
link "$here/dotfiles/sway/environment" ~/.config/sway/environment
# An alias for this script, so config.d/40-autostart.conf can reach it the way
# the config reaches every other script, as ~/.config/sway/<name>, instead of
# being the one line that hardcodes where the repo was cloned.
link "$here/scripts/link-sway" ~/.config/sway/relink
