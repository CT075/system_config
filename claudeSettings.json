{
  "env": {
    "ENABLE_LSP_TOOL": "1"
  },
  "attribution": {
    "commit": ""
  },
  "model": "claude-opus-5",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.cwd // \"\"' | { read -r d; notify-send -a \"Claude Code\" -i dialog-information \"Claude Code\" \"Response finished${d:+ in ${d##*/}}\"; } 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "i-have-adhd@i-have-adhd": true
  },
  "extraKnownMarketplaces": {
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    }
  },
  "outputStyle": "writelikeme",
  "theme": "dark",
  "editorMode": "vim"
}
